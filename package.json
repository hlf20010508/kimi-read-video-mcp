{
  "name": "kimi-read-video-mcp",
  "version": "0.1.0",
  "description": "Minimal MCP server that exposes a single kimi_read_video tool for Moonshot and Kimi Coding.",
  "type": "module",
  "main": "./dist/server.js",
  "bin": {
    "kimi-read-video-mcp": "./bin/kimi-read-video-mcp"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "kimi",
    "video",
    "moonshot",
    "coding"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "npm run test:live:api && npm run test:live:mcp",
    "test:live:api": "tsx tests/live-smoke.ts",
    "test:live:mcp": "npm run build && tsx tests/mcp-stdio-live.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.9"
  }
}